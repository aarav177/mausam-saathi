# Copy this file to .env and add a key created in your provider dashboard.
# Do not put real API keys in this template or share them in chat.
# AI advisory provider (backend only).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# SMS remains disabled by default. Live SMS and OTP require all MSG91
# credentials, MSG91 templates, and approved DLT values below. Test mode never
# sends real messages; OTP verification is available only in live mode.
SMS_ENABLED=false
SMS_TEST_MODE=false
SMS_PROVIDER=msg91
SMS_OTP_EXPIRY_SECONDS=300
SMS_OTP_RESEND_COOLDOWN_SECONDS=30

# MSG91 credentials and India DLT values. Keep blank until registered and
# approved; never expose these values to the browser or commit a real .env.
# Register/map each DLT template and sender in MSG91. The SMS Flow template
# must use VAR1 for the supplied test-message text.
SMS_DLT_APPROVED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_TEMPLATE_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_SENDER_ID=
SMS_DLT_OTP_TEMPLATE_ID=  # DLT content-template ID mapped to MSG91_OTP_TEMPLATE_ID
SMS_DLT_TEMPLATE_ID=      # DLT content-template ID mapped to MSG91_SMS_TEMPLATE_ID
